# Server configuration
PORT=3000
NODE_ENV=development
AUTH_STORE=sqlite

# Pepper secret for HMAC-SHA256 password hashing (at least 32 characters, never commit to git)
# Primary variable name:
PASSWORD_PEPPER=replace_with_a_secure_random_hex_or_string_pepper_min_32_chars
# Backward-compatible alias:
PEPPER=replace_with_a_secure_random_hex_or_string_pepper_min_32_chars

# Session secret for signing cookies and CSRF tokens
SESSION_SECRET=replace_with_a_secure_random_session_secret_min_32_chars

# AES-256-GCM encryption key for TOTP secrets (must be 64 hex characters = 32 bytes)
ENCRYPTION_KEY=replace_with_32_random_bytes_encoded_as_64_hex_characters

# Frontend URL for CORS (e.g., https://localhost:3000 if served locally or Live Server)
FRONTEND_ORIGIN=https://localhost:3000
WEB_ORIGINS=https://localhost:3000,http://localhost:8081

# One-time administrator bootstrap; configure before running npm run seed.
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Supabase Online Backup Configuration
# Replace with your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Server-Side Secret Key / Service-Role Key (server-side only, never expose to frontend or git)
SUPABASE_SECRET_KEY=replace_with_your_supabase_secret_key


# Private AWS S3 copy of encrypted library database backups
AWS_REGION=eu-north-1
AWS_S3_BUCKET=lms-db-backups-esmee2022-eun1-20261018-7c41a9
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
