{
  "expo": {
    "name": "Library Workspace",
    "slug": "library-workspace",
    "scheme": "libraryworkspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", ["expo-secure-store", {"configureAndroidBackup": true}]],
    "ios": {"supportsTablet": true, "bundleIdentifier": "edu.library.workspace", "config": {"usesNonExemptEncryption": false}},
    "android": {"package": "edu.library.workspace"},
    "experiments": {"typedRoutes": true}
  }
}
