{
  "name": "login-and-signup-system",
  "version": "1.0.0",
  "private": true,
  "description": "Library Management System with two-factor authentication and role-based access",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "start:http": "node server/server.js --http",
    "build:vercel": "node scripts/prepare-vercel.js",
    "seed": "node server/scripts/seed.js",
    "test": "node server/tests/test_flow.js",
    "test:auth-api": "node server/tests/test_auth_smoke.js",
    "test:cloud-schema": "node server/tests/test_cloud_schema.js",
    "test:all": "node server/tests/test_flow.js && node server/tests/test_auth_smoke.js && node server/tests/test_cloud_schema.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
